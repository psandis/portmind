{
  "name": "@portmind/web",
  "version": "0.2.0",
  "description": "Local-only web dashboard for portmind - static HTML/JS over @portmind/core's /api/ports.",
  "homepage": "https://github.com/psandis/portmind#readme",
  "bugs": "https://github.com/psandis/portmind/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psandis/portmind.git",
    "directory": "packages/web"
  },
  "license": "MIT",
  "author": "Petri Sandholm",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "static"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@portmind/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
